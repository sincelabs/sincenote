# Environment for the Coolify AFFiNE deployment.
#
# On Coolify, paste the values you need into the application's Environment
# Variables tab. Only POSTGRES_PASSWORD and REDIS_PASSWORD are mandatory —
# without them the deploy stops immediately with a message naming the variable.
#
# Coolify's SERVICE_FQDN_* / SERVICE_PASSWORD_* magic variables are deliberately
# not used here: they belong to the Service resource type, and under the Docker
# Compose build pack they expand to empty strings instead.
#
# To run the same stack locally without Coolify:
#   cp .docker/coolify/env.example .env.local
#   docker compose --env-file .env.local up --build

# --- Required ---------------------------------------------------------------
# Generate real values, e.g. `openssl rand -hex 24`.
# Any characters are safe: the entrypoint percent-encodes the Postgres password
# when it builds the connection URL, and Redis reads its own from the
# environment. Base64 passwords containing / or + are fine.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# --- Public URL -------------------------------------------------------------
# Leave both unset on Coolify and the entrypoint derives them from the domain
# Coolify injects (COOLIFY_URL / COOLIFY_FQDN). Set them to pin the public URL,
# which is what invite links, OAuth redirects and outgoing mail use.
# AFFINE_SERVER_EXTERNAL_URL=https://note.example.com
# AFFINE_SERVER_HOST=note.example.com

# false when serving over plain HTTP, e.g. a local run.
AFFINE_SERVER_HTTPS=true
# Set only when AFFiNE lives under a path, e.g. /affine.
# AFFINE_SERVER_SUB_PATH=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=affine
POSTGRES_DB=affine
# Point at an external Postgres instead of the bundled one. Setting this makes
# the entrypoint use it verbatim and ignore the POSTGRES_* parts above, so
# percent-encode the password yourself.
# DATABASE_URL=postgresql://user:pass@db.example.com:5432/affine
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# --- Build ------------------------------------------------------------------
# stable | beta | internal | canary
BUILD_TYPE=stable
# Heap for the frontend bundler. Lower it on a small builder, but below ~4096
# the web build tends to run out of memory.
NODE_HEAP_MB=6144
# Coolify sets this; only needed for local builds, and optional even then.
# SOURCE_COMMIT=

# --- Runtime ----------------------------------------------------------------
# Heap for the running server.
AFFINE_HEAP_MB=2048

# --- Registry deploys (.docker/coolify/compose.registry.yaml) ---------------
# AFFINE_IMAGE=ghcr.io/sincelabs/sincenote:latest

# --- SMTP -------------------------------------------------------------------
# Without these, invitations, password resets and email sign-in silently fail.
# MAILER_HOST=smtp.example.com
# MAILER_PORT=465
# MAILER_USER=noreply@example.com
# MAILER_PASSWORD=
# MAILER_SENDER=AFFiNE Self Hosted <noreply@example.com>
# MAILER_IGNORE_TLS=false
