# Environment for the Coolify AFFiNE deployment.
#
# On Coolify you do NOT need most of this: the SERVICE_* values below are
# "magic variables" that Coolify generates and injects for you. Paste only the
# optional settings (SMTP, tuning) into the application's Environment Variables
# tab.
#
# Copy this file to `.env.local` next to docker-compose.yaml if you want to run
# the same stack locally without Coolify:
#   cp .docker/coolify/env.example .env.local
#   docker compose --env-file .env.local up --build

# --- Generated by Coolify. Only set these for local runs. ------------------
# Public hostname, no scheme.
SERVICE_FQDN_AFFINE=affine.localhost
# Public URL, with scheme.
SERVICE_URL_AFFINE=http://affine.localhost:3010
# Use real secrets. These are placeholders.
SERVICE_PASSWORD_POSTGRES=change-me-postgres
SERVICE_PASSWORD_REDIS=change-me-redis
# The commit being deployed; stamped into the frontend build.
SOURCE_COMMIT=0000000000000000000000000000000000000000

# --- Server ----------------------------------------------------------------
# false when serving over plain HTTP, e.g. a local run.
AFFINE_SERVER_HTTPS=true
# Set only when AFFiNE lives under a path, e.g. /affine.
# AFFINE_SERVER_SUB_PATH=

# --- Database --------------------------------------------------------------
POSTGRES_USER=affine
POSTGRES_DB=affine

# --- Build -----------------------------------------------------------------
# stable | beta | internal | canary
BUILD_TYPE=stable
# Heap for the frontend bundler. Lower it on a small builder, but below ~4096
# the web build tends to run out of memory.
NODE_HEAP_MB=6144

# --- Runtime ---------------------------------------------------------------
# Heap for the running server.
AFFINE_HEAP_MB=2048

# --- Registry deploys (.docker/coolify/compose.registry.yaml) --------------
# AFFINE_IMAGE=ghcr.io/sincelabs/affine:latest

# --- SMTP ------------------------------------------------------------------
# Without these, invitations, password resets and email sign-in silently fail.
# MAILER_HOST=smtp.example.com
# MAILER_PORT=465
# MAILER_USER=noreply@example.com
# MAILER_PASSWORD=
# MAILER_SENDER=AFFiNE Self Hosted <noreply@example.com>
# MAILER_IGNORE_TLS=false
